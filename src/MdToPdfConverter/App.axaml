<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MdToPdfConverter.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#E8E8E8" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="Foreground" Value="#E8E8E8" />
        </Style>

        <Style Selector="TextBlock.title">
            <Setter Property="Foreground" Value="#F1F1F1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.subtitle">
            <Setter Property="Foreground" Value="#8E8E8E" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#777777" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="#212121" />
            <Setter Property="BorderBrush" Value="#303030" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#303030" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#393939" />
            <Setter Property="BorderBrush" Value="#505050" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#424242" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#242424" />
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="BorderBrush" Value="#5A5A5A" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="BorderBrush" Value="#808080" />
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="#353535" />
            <Setter Property="BorderBrush" Value="#929292" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#989898" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="#252525" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.ghost:pressed">
            <Setter Property="Background" Value="#303030" />
        </Style>
        <Style Selector="Button.close">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A8A8A8" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.close:pointerover">
            <Setter Property="Background" Value="#303030" />
            <Setter Property="Foreground" Value="#F0F0F0" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#242424" />
            <Setter Property="Foreground" Value="#E2E2E2" />
            <Setter Property="BorderBrush" Value="#373737" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="BorderBrush" Value="#505050" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Foreground" Value="#E2E2E2" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="#353535" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#353535" />
            <Setter Property="Foreground" Value="#E2E2E2" />
        </Style>
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background" Value="#3D3D3D" />
            <Setter Property="Foreground" Value="#F1F1F1" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3D3D3D" />
            <Setter Property="Foreground" Value="#F1F1F1" />
        </Style>

        <Style Selector="Slider">
            <Setter Property="Foreground" Value="#E8E8E8" />
        </Style>
        <Style Selector="CheckBox.toggle">
            <Setter Property="Foreground" Value="#C8C8C8" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate TargetType="CheckBox">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border x:Name="Track"
                                Width="34"
                                Height="20"
                                Background="#303030"
                                BorderBrush="#484848"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Ellipse x:Name="Thumb"
                                     Width="12"
                                     Height="12"
                                     Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="#A8A8A8" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="9,0,0,0"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.toggle:pointerover /template/ Border#Track">
            <Setter Property="BorderBrush" Value="#686868" />
        </Style>
        <Style Selector="CheckBox.toggle:checked /template/ Border#Track">
            <Setter Property="Background" Value="#E8E8E8" />
            <Setter Property="BorderBrush" Value="#E8E8E8" />
        </Style>
        <Style Selector="CheckBox.toggle:checked /template/ Ellipse#Thumb">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Fill" Value="#1C1C1C" />
        </Style>
        <Style Selector="CheckBox.toggle:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Background" Value="#303030" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
    </Application.Styles>
</Application>
